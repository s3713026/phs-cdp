# ============================================================
# PHS CDP — Unified .env
# Location: CDP/.env  (one level above phs-cdp-bff/ and phs-cdp-ui/)
# NEVER commit this file — add to .gitignore
# ============================================================

# ─── RudderStack ─────────────────────────────────────────────
RUDDERSTACK_DATA_PLANE_URL=http://rudder-server:8080
RUDDERSTACK_WRITE_KEY=phs_server_write_key_2024
RUDDER_ADMIN_PASSWORD=PHS@Rudder2024!

# ─── RudderStack Postgres (internal — DO NOT CHANGE service name) ──
POSTGRES_USER=rudder
POSTGRES_PASSWORD=rudderpassword
POSTGRES_DB=jobsdb

# ─── Mautic ──────────────────────────────────────────────────
MAUTIC_URL=http://mautic:80
MAUTIC_USERNAME=phs_admin
MAUTIC_PASSWORD=CHANGE_ME

# ─── Mautic MySQL (internal) ─────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=CHANGE_ME_MAUTIC_PASS

# ─── CDP Profile Store (NEW) ─────────────────────────────────
CDP_DB_HOST=cdp-postgres
CDP_DB_PORT=5432
CDP_DB_NAME=phs_cdp
CDP_DB_USER=cdp_user
CDP_DB_PASSWORD=CHANGE_ME_VERY_STRONG_PASSWORD
