        <mxCell id="n4" value="⚠ BFF đọc data qua RS API :3000 · KHÔNG truy cập PG/MySQL trực tiếp" style="text;html=1;align=center;strokeColor=#2e7d32;fillColor=#e8f5e9;fontSize=11;fontStyle=1;rounded=1;" vertex="1" parent="1">
