        <!-- ══ CDP UI ══ -->
        <mxCell id="cdp_ui" value="📱 PHS CDP UI — Marketing Workspace&#xa;BFF đọc data từ RS + Mautic → trả về cho UI qua /api/*&#xa;Marketing chỉ nhìn thấy layer này · Không biết RS hay Mautic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
