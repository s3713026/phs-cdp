        <!-- ══ BAND 2: RS DATA PLANE ══ -->
        <mxCell id="rs_dp" value="⚡ RudderStack Data Plane :8080&#xa;Entry point · Xác thực Write Key · Return 200 OK ngay&#xa;BFF KHÔNG đứng giữa luồng này" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f59e0b;strokeWidth=2;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="860" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow: RS DP → PG (immediate write) -->
        <mxCell id="a_dp_pg" value="① Ghi NGAY vào job queue&#xa;(synchronous, trước khi xử lý)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;fontStyle=1;endArrow=block;endFill=1;" edge="1" source="rs_dp" target="pg_queue" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ PostgreSQL Job Queue ══ -->
        <mxCell id="pg_queue" value="🗄 PostgreSQL — RS Internal Job Queue&#xa;table: jobs (status: waiting → processing → succeeded)&#xa;RS lưu event vào đây TRƯỚC KHI xử lý · Retry nếu fail" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="530" width="560" height="100" as="geometry"/>
        </mxCell>

        <!-- Arrow: PG Queue → RS Processor -->
        <mxCell id="a_pg_proc" value="② RS đọc từ queue → xử lý async" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#f59e0b;fontColor=#e65100;fontSize=10;fontStyle=1;endArrow=block;endFill=1;" edge="1" source="pg_queue" target="rs_proc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ RS PROCESSOR ══ -->
        <mxCell id="rs_proc" value="RS Event Processor&#xa;Validation → Transformation (JS) → Identity Resolution&#xa;PII masking · anonymousId ↔ userId merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="660" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow: RS Proc → Destination Router -->
        <mxCell id="a_proc_route" value="③ Fan-out to destinations" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d97706;fontColor=#d97706;fontSize=10;fontStyle=1;endArrow=block;endFill=1;" edge="1" source="rs_proc" target="dest_router" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ DESTINATION ROUTER ══ -->
        <mxCell id="dest_router" value="RS Destination Router" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
