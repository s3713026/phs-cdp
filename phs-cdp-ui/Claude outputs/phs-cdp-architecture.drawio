        <mxCell id="dest_pg" value="🗄 PostgreSQL&#xa;RS Profile Store&#xa;users · tracks · identifies&#xa;Source of truth" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
