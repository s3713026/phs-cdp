        <mxCell id="n3" value="⚠ Webhook → BFF là async · BFF fail KHÔNG ảnh hưởng RS" style="text;html=1;align=center;strokeColor=#7c3aed;fillColor=#f3e5f5;fontSize=11;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1000" width="480" height="40" as="geometry"/>
