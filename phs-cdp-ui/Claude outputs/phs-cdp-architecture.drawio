        <!-- Dest 3: Warehouse (future) -->
        <mxCell id="dest_wh" value="☁ Warehouse&#xa;S3 / BigQuery&#xa;(future phase)&#xa;Analytics" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontSize=11;strokeDasharray=6 3;" vertex="1" parent="1">
          <mxGeometry x="1180" y="960" width="220" height="110" as="geometry"/>
