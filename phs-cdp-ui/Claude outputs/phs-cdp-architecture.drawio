        <mxCell id="a_r_s3" value="→ Warehouse (future)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5c6bc0;fontColor=#5c6bc0;fontSize=9;dashed=1;dashPattern=5 3;endArrow=block;endFill=1;" edge="1" source="dest_router" target="dest_wh" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ BFF ══ -->
        <mxCell id="bff" value="⚙ BFF API :3001&#xa;Nhận webhook từ RS · Auth · RBAC · PII Masking · Audit Log&#xa;RudderStackAdapter · MauticAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="1130" width="480" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow: Webhook → BFF -->
        <mxCell id="a_wh_bff" value="async POST (sau khi RS xong)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;fontStyle=1;dashed=1;dashPattern=5 3;endArrow=block;endFill=1;" edge="1" source="dest_webhook" target="bff" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- BFF reads RS PostgreSQL via API -->
        <mxCell id="a_bff_pg" value="BFF reads via RS&#xa;Control Plane :3000" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=9;dashed=1;dashPattern=4 2;endArrow=open;" edge="1" source="bff" target="dest_pg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ MAUTIC ══ -->
        <mxCell id="mautic" value="🟢 Mautic :8081&#xa;Audience / Segment Engine&#xa;Sync contact từ BFF&#xa;lead_lists · lead_list_leads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
