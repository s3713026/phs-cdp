        </mxCell>

        <!-- Dest 2: Webhook → BFF -->
        <mxCell id="dest_webhook" value="Webhook Destination&#xa;POST async → BFF :3001&#xa;/internal/rudder-sync&#xa;KHÔNG block RS processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7c3aed;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="980" width="240" height="90" as="geometry"/>
