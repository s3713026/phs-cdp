# ── Environment (NEVER commit real credentials) ───────────────
.env
*.env
!.env.example

# ── Node ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Temp files ───────────────────────────────────────────────
*.tmp
*.bak

# ── Docker volumes / data ────────────────────────────────────
data/
pg_data/
mysql_data/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Secrets / config with real credentials ────────────────────
# Block workspaceConfig at root and in bff (may contain DB passwords, tokens)
# but ALLOW rudderstack/workspaceConfig.json (only contains internal write keys)
workspaceConfig.json
!rudderstack/workspaceConfig.json
