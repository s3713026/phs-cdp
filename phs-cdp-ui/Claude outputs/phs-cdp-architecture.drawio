        <mxCell id="a_r_wh" value="→ Webhook async" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=9;endArrow=block;endFill=1;" edge="1" source="dest_router" target="dest_webhook" parent="1">
          <mxGeometry relative="1" as="geometry"/>
